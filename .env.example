# Copy to .env and fill in. NEVER commit .env — the key is billable and any
# value here that reaches the browser is public.
AI_API_URL=https://your-endpoint/api
AI_API_KEY=sk-...
AI_CHAT_COMPLETIONS_PATH=/chat/completions

# sokrates-fast is the default: this is grounded Q&A over ~21 short chunks, so
# retrieval quality dominates and a bigger model mostly buys latency.
# Measured on this KB: first token ~1.6-2.3s, full answer ~3.7-6.8s.
AI_MODEL_FAST=sokrates-fast
AI_MODEL_REASONING=qwen3.6-35b
AI_MODEL_GERMAN_COPY=gemma4-31b
AI_MODEL_PRO=sokrates-pro
